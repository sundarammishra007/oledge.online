rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Fields: uid, name, email, role, college, branch, skills, resumeUrl, portfolioLinks, interests, isVerified, createdAt, projects, certifications, volunteerExperience
    //
    // Collection: internships
    // Fields: id, title, companyId, companyName, location, isRemote, stipend, description, skillsRequired, deadline, createdAt
    //
    // Collection: hackathons
    // Fields: id, eventName, organizer, description, deadline, applyUrl, createdAt
    //
    // Collection: jobfairs
    // Fields: id, title, location, date, organizer, companies, createdAt
    //
    // Collection: freelance_projects
    // Fields: id, title, budget, deadline, description, skillsRequired, createdAt
    //
    // Collection: library
    // Fields: id, title, author, publisherId, description, category, fileUrl, createdAt
    //
    // Collection: calendar
    // Fields: id, title, date, type, creatorId, creatorRole, description, createdAt
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && 
        ((request.auth.token.email == "sundarammishra000001@gmail.com" && request.auth.token.email_verified == true) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }
    function isGovt() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'govt';
    }
    function isCollege() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'college';
    }
    function isCompany() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role']) &&
             data.uid is string && data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.role in ['student', 'govt', 'college', 'company', 'admin'] &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 1048576)) &&
             (!('backgroundURL' in data) || (data.backgroundURL is string && data.backgroundURL.size() < 1048576)) &&
             (!('projects' in data) || data.projects is list) &&
             (!('certifications' in data) || data.certifications is list) &&
             (!('volunteerExperience' in data) || data.volunteerExperience is list) &&
             (!('summary' in data) || data.summary is string) &&
             (!('education' in data) || data.education is list);
    }

    function isValidInternship(data) {
      return data.keys().hasAll(['title', 'companyId', 'companyName', 'description']) &&
             data.title is string && data.title.size() < 200 &&
             data.description is string && data.description.size() < 5000;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data);
    }

    match /internships/{internshipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isCompany() || isAdmin());
      allow update: if isAuthenticated() && (resource.data.companyId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.companyId == request.auth.uid || isAdmin());
    }

    match /hackathons/{hackathonId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.organizerId == request.auth.uid || isAdmin());
    }

    match /jobfairs/{jobfairId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.organizerId == request.auth.uid || isAdmin());
    }

    match /freelance_projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());
    }

    match /library/{bookId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.publisherId == request.auth.uid || isAdmin());
    }

    match /calendar/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());
    }

    match /apprenticeships/{apprenticeshipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.organizerId == request.auth.uid || isAdmin());
    }

    match /notices/{noticeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'reposts', 'commentsCount']));
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    match /friend_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.receiverId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
    }

    match /seminars/{seminarId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.organizerId == request.auth.uid || isAdmin());
    }

    match /forum_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasAny(['upvotes', 'downvotes', 'viewsCount', 'commentsCount']));
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'isCorrectAnswer']));
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.organizerId == request.auth.uid || isAdmin());
    }
  }
}
